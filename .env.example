# SK Open API (https://openapi.sk.com) 에서 발급받은 앱키
# TMAP 대중교통 API(지하철 혼잡도) 사용 신청 후 발급된 appKey를 넣으세요.
# appKey는 API별이 아니라 앱 단위 하나로 열차/칸 혼잡도 API에 공통 사용됩니다.
# 비워두면 통계 패턴 기반 데모 데이터로 동작합니다.
SK_APP_KEY=

# 혼잡도 API 호출 방식 (기본: 자동 감지 — puzzle 먼저 시도 후 transit)
#  puzzle : "Free(지하철 혼잡도) PUZZLE-SUBWAY" 상품 (역 코드 방식, 1~8호선)
#  transit: "TMAP 대중교통" 상품 (노선명+역명 방식, 1~9호선)
# SK_API_MODE=puzzle

# 서버 포트 (기본 3000)
PORT=3000
